# Skopiuj ten plik jako .env i uzupełnij. Pliku .env NIE wrzucaj na GitHuba.

# Klucz API Anthropic (console.anthropic.com). Puste = działa tylko na regułach.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Ile sprawdzeń na minutę z jednego adresu IP
RATE_LIMIT_PER_MINUTE=10

# Co ile minut odświeżać Listę Ostrzeżeń CERT
CERT_REFRESH_MINUTES=60

# true = API pokazuje punkty i wszystkie sygnały (tylko do testów, nie na produkcji!)
DEBUG=false
